# Copy to .env for running on your machine: `cp .env.example .env`
# Every variable here is read by app/core/env.py.

PROJECT_NAME="Knowledge Base API"
ENVIRONMENT=local            # local | test | production
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000

DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Per-API limits live in app/core/rate_limiting.py; this only switches them on/off.
RATE_LIMIT_ENABLED=true

# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
