# Copy to .env for running the API outside Docker (uvicorn on your machine).
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://kb:kb@localhost:5432/kb
REDIS_URL=redis://localhost:6379/0
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-secret-change-me-in-production-0000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_AUTH=5
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]
